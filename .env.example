# Copy to .env or export these in your shell before running an evaluation.
# .env is gitignored; never commit a real API key.

# --- scripts/eval_gemini.py ---------------------------------------------
# generateContent URL. Two forms are accepted:
#
# 1. Prefix: the script appends "/${MODEL_NAME}:generateContent".
#      BASE_URL=https://<your-host>/v1beta/models
#      -> https://<your-host>/v1beta/models/gemini-3.8-flash:generateContent
#
# 2. Template: include the "{model}" placeholder and the URL is used verbatim.
#    Use this when a relay or proxy exposes a different path.
#      BASE_URL=https://<your-host>/v1beta/models/{model}:generateContent
#      -> https://<your-host>/v1beta/models/gemini-3.8-flash:generateContent
#
# --- scripts/eval_mimo.py -----------------------------------------------
# OpenAI-compatible base URL, typically ending in /v1.
#      BASE_URL=https://<your-host>/v1
BASE_URL=https://<your-host>/v1beta/models

# Provider API key, sent as "Authorization: Bearer ${API_KEY}" by the Gemini
# adapter and through the OpenAI SDK by the MiMo adapter.
API_KEY=replace-with-your-api-key

# Model identifier. Gemini: gemini-3.8-flash.
# MiMo: mimo-v2.6-pro or mimo-v2.6-flash (MiMo-v2.5 is no longer served).
MODEL_NAME=gemini-3.8-flash
